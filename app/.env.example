# Copy ke .env di VPS. JANGAN commit .env asli.
DATABASE_URL="mysql://crm:crm-secret@localhost:3306/crm_isp"
JWT_SECRET="ganti-minimal-32-karakter-di-vps"

# Server MRTG existing
MRTG_DEFAULT_BASE_URL="https://mrtg.internal/api"
MRTG_TIMEOUT_MS=5000
MRTG_CACHE_TTL=180
# Kunci enkripsi token MRTG (opsional; fallback ke JWT_SECRET). Isi string acak panjang.
MRTG_TOKEN_KEY="ganti-juga-minimal-32-karakter"

# Cron preload MRTG (curl dengan Bearer ini tiap 5 menit)
CRON_SECRET="ganti-cron-secret-acak"

# Next.js
NODE_ENV=production
PORT=3000
